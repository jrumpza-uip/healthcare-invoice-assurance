          "outputId": "error"
        }
      },
      {
        "id": "evaluateFinancials.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "valid",
                "invalid",
                "technicalError"
              ],
              "title": "Status",
              "type": "string"
            },
            "authoritativeFindings": {
              "items": {
                "properties": {
                  "findingId": {
                    "title": "Findingid",
                    "type": "string"
                  },
                  "chargeId": {
                    "title": "Chargeid",
                    "type": "string"
                  },
                  "ruleId": {
                    "title": "Ruleid",
                    "type": "string"
                  },
                  "ruleType": {
                    "title": "Ruletype",
                    "type": "string"
                  },
                  "status": {
                    "title": "Status",
                    "type": "string"
                  },
                  "submittedAmount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Submittedamount"
                  },
                  "allowedAmount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],

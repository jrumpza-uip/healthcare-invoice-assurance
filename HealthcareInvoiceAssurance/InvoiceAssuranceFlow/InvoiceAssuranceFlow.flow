    "persistInitialAnalysis": {
      "nodes": [
        {
          "id": "persistInitialStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "10b7eb74-e502-49a7-91c3-c75715c315fe",
            "isDefaultEntryPoint": true
          },
          "outputs": {

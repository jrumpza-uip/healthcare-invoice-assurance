            }
          }
        },
        {
          "id": "prepareInitialPersistence",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Prepare initial persistence"
          },
          "inputs": {
            "script": "const input = $vars.persistInitialStart.output; const evaluation = input.evaluation ?? {}; const snapshot = evaluation.financialSnapshot ?? {}; const invoice = input.canonicalPackage?.invoice ?? {}; const charges = input.canonicalPackage?.canonicalCharges ?? []; const sourceDocumentIds = Array.isArray(input.sourceDocumentIds) ? input.sourceDocumentIds : []; const documents = Array.isArray(input.canonicalPackage?.documents) && input.canonicalPackage.documents.length > 0 ? input.canonicalPackage.documents : sourceDocumentIds.map((documentId) => ({ documentId, bucketPath: documentId, displayName: documentId, documentType: 'invoice-support', checksum: '' })); const context = input.technicalContext ?? {}; const error = context.extractionError ?? context.lookupError ?? context.agentError ?? context.evaluationError ?? null; const hasTechnicalIssue = context.unsupportedProfile === true || context.searchStatus === 'SearchIncomplete' || error !== null; const issueTitle = context.unsupportedProfile === true ? 'Unsupported contract profile' : context.searchStatus === 'SearchIncomplete' ? 'Project-cost search incomplete' : error?.message ?? 'Technical analysis exception'; const issueExplanation = error?.detail ?? error?.message ?? (context.unsupportedProfile === true ? 'The submitted contract profile is not supported by this demo and requires reviewer direction.' : 'The project-cost lookup could not establish a complete search result and requires reviewer direction.'); const technicalFinding = hasTechnicalIssue ? { findingId: `technical-${input.invoiceRecordId}`, chargeId: charges[0]?.chargeId ?? '', ruleId: 'technical-review', severity: 'High', category: 'Technical exception', title: issueTitle, explanation: issueExplanation, financialEffect: 0, adjustment: 0, status: 'technicalError', confidence: 1, evidenceState: 'technicalError', contractDocumentTitle: '', contractClause: '', contractExcerptSummary: '', applicabilityExplanation: 'Automated processing stopped safely and routed the complete available package to a reviewer.', sourceDocumentId: documents[0]?.documentId ?? '' } : null; const findings = [...(evaluation.authoritativeFindings ?? []), ...(technicalFinding ? [technicalFinding] : [])]; const awaitingEvidence = findings.some((finding) => finding.status === 'pendingEvidence' || finding.evidenceState === 'missingEvidence'); const analysisVersion = Number(snapshot.version ?? 1); const submittedTotal = Number(snapshot.submittedTotal ?? invoice.total ?? 0); const adjustmentTotal = Number(snapshot.totalAdjustment ?? 0); const payableTotal = Number(snapshot.proposedPayable ?? submittedTotal - adjustmentTotal); const timestamp = new Date().toISOString(); const activity = [{ eventTimestamp: timestamp, eventName: input.eventName, eventType: hasTechnicalIssue ? 'TechnicalReviewRequired' : input.eventType, summary: hasTechnicalIssue ? issueTitle : `Analysis version ${analysisVersion} prepared` }]; const lineRecords = charges.map((charge) => { const chargeFindings = findings.filter((finding) => finding.chargeId === charge.chargeId); const adjustment = chargeFindings.reduce((maximum, finding) => Math.max(maximum, Number(finding.adjustment ?? 0)), 0); const allowedAmount = Math.max(0, Number(charge.submittedAmount ?? 0) - adjustment); return { InvoiceRecordId: input.invoiceRecordId, SourceDocumentId: charge.sourceDocumentId ?? '', SourceDocumentType: charge.sourceDocumentType ?? 'invoice', Description: charge.description ?? '', Category: charge.category ?? 'unclassified', Quantity: Number(charge.quantity ?? 1), Unit: charge.unit ?? 'each', SubmittedRate: Number(charge.unitRate ?? 0), SubmittedAmount: Number(charge.submittedAmount ?? 0), IxpConfidence: Number(charge.ixpConfidence ?? 0), SourceCoordinatesJson: JSON.stringify(charge.sourceCoordinates ?? {}), ExternalRecordId: charge.externalRecordId ?? charge.chargeId ?? '', ExternalMatchStatus: charge.externalMatchStatus ?? 'NotMatched', ExternalAmount: Number(charge.externalAmount ?? 0), Variance: Number(charge.variance ?? 0), AllowedAmount: allowedAmount, Adjustment: adjustment, EvaluationStatus: chargeFindings.some((finding) => ['pendingEvidence', 'technicalError', 'ambiguous'].includes(finding.status)) ? 'NeedsReview' : adjustment > 0 ? 'Adjusted' : 'Allowed', AnalysisVersion: analysisVersion }; }); return { ...evaluation, status: hasTechnicalIssue ? 'technicalError' : evaluation.status ?? 'valid', invoiceRecordId: input.invoiceRecordId, correlationId: input.correlationId, analysisVersion, reviewCycle: 1, financialSnapshot: { ...snapshot, submittedTotal, totalAdjustment: adjustmentTotal, proposedPayable: payableTotal, version: analysisVersion }, invoiceSummary: { invoiceNumber: invoice.number ?? '', invoiceDate: invoice.date ?? '', supplierName: input.canonicalPackage?.supplier?.name ?? '', accountName: 'Lakeshore Regional Health System', projectName: 'West Pavilion Renovation', contractProfileId: 'profile-west-pavilion', submittedTotal, currentAdjustment: adjustmentTotal, currentPayable: payableTotal, openFindingCount: findings.length, awaitingEvidence }, authoritativeFindings: findings, lineItems: charges, lineRecords, documents, activity, technicalContext: context, mainRecord: { ProcessingStatus: 'ReviewerPending', AnalysisVersion: analysisVersion, FindingsJson: JSON.stringify(findings), SubmittedTotal: submittedTotal, AdjustmentTotal: adjustmentTotal, PayableTotal: payableTotal, OpenFindingCount: findings.length, AwaitingEvidence: awaitingEvidence }, activityRecord: { InvoiceRecordId: input.invoiceRecordId, CorrelationId: input.correlationId, EventTimestamp: timestamp, EventName: input.eventName, EventType: hasTechnicalIssue ? 'TechnicalReviewRequired' : input.eventType, EventSource: input.eventSource, Summary: hasTechnicalIssue ? issueTitle : `Initial analysis version ${analysisVersion} prepared`, PayloadJson: JSON.stringify({ snapshot, findings, technicalContext: context }) } };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Prepared analysis records",
              "source": "=result.response",
              "var": "output"
            },

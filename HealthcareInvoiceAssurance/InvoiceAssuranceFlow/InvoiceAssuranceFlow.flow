        "contractProfileId": "=js:$vars.validateSubmission.output.contractProfileId",
        "invoiceDate": "=js:$vars.normalizeCharges.output.invoice.date",
        "canonicalCharges": "=js:$vars.currentReviewPackage.lineItems",
        "documents": "=js:$vars.currentReviewPackage.documents",
        "priorActivity": "=js:$vars.currentReviewPackage.activity",

        "id": "activity-properties",
        "title": "Agent",
        "sections": [
          {
            "id": "inputs",
            "title": "Inputs",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.correlationId",
                "type": "text",
                "label": "correlationId"
              },
              {
                "name": "inputs.invoiceRecordId",
                "type": "text",
                "label": "invoiceRecordId"
              },
              {
                "name": "inputs.contractProfileId",
                "type": "text",

          "display": {
            "label": "Reanalyze changed findings"
          },
          "inputs": {
            "correlationId": "=js:$vars.reevaluateStart.output.correlationId",
            "invoiceRecordId": "=js:$vars.reevaluateStart.output.invoiceRecordId",
            "contractProfileId": "=js:$vars.reevaluateStart.output.contractProfileId",
            "invoiceDate": "=js:$vars.reevaluateStart.output.invoiceDate",
            "canonicalCharges": "=js:$vars.reevaluateStart.output.canonicalCharges",
            "reconciliationSummary": "=js:$vars.reevaluateStart.output.reconciliationSummary",
            "precedencePolicy": "=js:$vars.reevaluateStart.output.precedencePolicy",

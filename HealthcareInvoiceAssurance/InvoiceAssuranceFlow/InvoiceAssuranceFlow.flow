          "invoiceSummary": "=vars.currentReviewPackage.invoiceSummary",
          "findings": "=vars.currentReviewPackage.authoritativeFindings",
          "charges": "=vars.currentReviewPackage.lineItems",
          "documents": "=vars.currentReviewPackage.documents",
          "activity": "=vars.currentReviewPackage.activity",
          "priorManagerRationale": "=vars.latestManagerRationale"
        },
        "title": "Invoice assurance manager task",
        "priority": "High",
        "labels": "healthcare,invoice-assurance,manager",
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "Approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "ReturnToReviewer",
              "name": "ReturnToReviewer",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            },
            {
              "id": "Reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Manager task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "ReturnToReviewer",
                "Reject"
              ]
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Manager task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "ReturnToReviewer",
            "Reject"
          ]
        }
      }
    },
    {
      "id": "routeManagerOutcome",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Route manager outcome"
      },
      "inputs": {
        "expression": "=js:$vars.managerTask.output.submittedMode === 'ReturnToReviewer' || $vars.managerTask.output.Action === 'ReturnToReviewer'",
        "trueLabel": "Return to reviewer",
        "falseLabel": "Finalize"
      }
    },
    {
      "id": "finalizeOutcome",
      "type": "core.subflow",
      "typeVersion": "1.0",
      "display": {
        "label": "Finalize outcome"
      },
      "inputs": {
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "managerDecision": "=js:$vars.managerTask.output",
        "latestAnalysis": "=js:$vars.reevaluateAffectedFindings.output",
        "eventName": "Final disposition recorded",
        "eventType": "FinalDisposition",
        "eventSource": "InvoiceAssuranceFlow.finalizeOutcome",
        "summary": "=js:$vars.managerTask.output.decisionSummary ?? $vars.managerTask.output.submittedMode ?? $vars.managerTask.output.Action"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Finalized invoice assurance outcome",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Finalization error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "processInstanceId": {
          "source": "=js:$metadata.instanceId"
        },
        "correlationId": {
          "source": "=js:$vars.validateSubmission.output.correlationId"
        },
        "canonicalPackage": {
          "source": "=js:$vars.canonicalPackage"
        },
        "currentReviewPackage": {
          "source": "=js:$vars.currentReviewPackage"
        },
        "reconciliationResult": {
          "source": "=js:$vars.reconciliationResult"
        },
        "contractAnalysis": {
          "source": "=js:$vars.contractAnalysis"
        },
        "analysisVersion": {
          "source": "=js:$vars.analysisVersion"
        },
        "reviewerDecision": {
          "source": "=js:$vars.reviewerDecision"
        },
        "latestManagerRationale": {
          "source": "=js:$vars.latestManagerRationale"
        },
        "managerDecision": {
          "source": "=js:$vars.managerTask.output"
        },
        "technicalErrors": {
          "source": "=js:[$vars.validateSubmission.error, $vars.markProcessing.error, $vars.extractPackage.error, $vars.normalizeCharges.error, $vars.lookupProjectCost.error, $vars.analyzeContract.error, $vars.evaluateFinancials.error, $vars.persistInitialAnalysis.error, $vars.persistReviewerWork.error, $vars.reevaluateAffectedFindings.error, $vars.finalizeOutcome.error].filter(Boolean)"
        }
      }
    }
  ],

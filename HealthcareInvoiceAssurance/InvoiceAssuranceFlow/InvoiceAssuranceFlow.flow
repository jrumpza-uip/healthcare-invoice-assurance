{
  "id": "c32bb746-0a7a-4a81-ac02-b187fc449894",
  "version": "1.9",
  "name": "InvoiceAssuranceFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "29947b52-8efc-46ad-a223-b463d807a0cb",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "validateSubmission",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate submission",
        "icon": "code"
      },
      "inputs": {
        "script": "const submission = $vars.start.output ?? {}; const required = ['invoiceRecordId', 'correlationId', 'contractProfileId']; const missing = required.filter((name) => typeof submission[name] !== 'string' || submission[name].trim() === ''); if (!Array.isArray(submission.sourceDocumentIds) || submission.sourceDocumentIds.filter(Boolean).length === 0) missing.push('sourceDocumentIds'); if (submission.contractProfileId !== 'profile-west-pavilion') missing.push('supported contractProfileId'); if (missing.length > 0) throw new Error(`Invalid submission: ${missing.join(', ')} required`); return { invoiceRecordId: submission.invoiceRecordId.trim(), correlationId: submission.correlationId.trim(), contractProfileId: submission.contractProfileId.trim(), sourceDocumentIds: [...new Set(submission.sourceDocumentIds.filter(Boolean))], accountId: submission.accountId ?? 'account-lakeshore-regional-health-system', projectId: submission.projectId ?? 'project-west-pavilion-renovation', simulateSearchUnavailable: submission.simulateSearchUnavailable === true, precedencePolicy: { mode: 'topic-specific', effectiveOnOrBeforeInvoiceDate: true } };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Validated submission context",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Submission validation error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "extractDocuments",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Extract all documents",
        "icon": "repeat"
      },
      "inputs": {
        "collection": "=js:$vars.validateSubmission.output.sourceDocumentIds",
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      }
    },
    {
      "id": "extractDocument",
      "type": "uipath.ixp.healthcare-invoice-assurance-51392a38-ixp.3994ca7a-2b93-807c-8f96-75602d7b1c47-79d872b0-bee1-4264-a6de-3e780f4e4239",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract document",
        "icon": "file-text"
      },
      "inputs": {
        "model": {
          "id": "3994ca7a-2b93-807c-8f96-75602d7b1c47",
          "modelName": "healthcare-invoice-assurance-51392a38-ixp",
          "modelDisplayName": "Healthcare Invoice Assurance",
          "folderKey": "79d872b0-bee1-4264-a6de-3e780f4e4239",
          "folderName": "AMER Presales/HLS",
          "folderPath": "8c19eac9-14be-4021-a784-70e216fd684f.79d872b0-bee1-4264-a6de-3e780f4e4239",
          "description": ""
        },
        "modelName": "healthcare-invoice-assurance-51392a38-ixp",
        "description": "",
        "projectName": "healthcare-invoice-assurance-51392a38-ixp",
        "versionTag": "25",
        "folderKey": "79d872b0-bee1-4264-a6de-3e780f4e4239",
        "folderName": "AMER Presales/HLS",
        "fileRef": "=js:$vars.extractDocuments.currentItem",
        "pageRange": "",
        "errorHandlingEnabled": false
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Published IXP extraction result",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "IXP extraction error",
          "source": "=Error",
          "var": "error"
        }
      },
      "parentId": "extractDocuments"
    },
    {
      "id": "collectDocumentExtraction",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "parentId": "extractDocuments",
      "display": {
        "label": "Collect extraction",
        "icon": "code"
      },
      "inputs": {
        "script": "return { sourceDocumentId: $vars.extractDocuments.currentItem, extraction: $vars.extractDocument.output };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "One document extraction with its source reference",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Extraction collection error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "normalizePackage",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize package",
        "icon": "code"
      },
      "inputs": {
        "script": "const packets = Array.isArray($vars.extractDocuments.output)\n    ? $vars.extractDocuments.output\n    : [];\n  const normalizeKey = (value) => String(value ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');\n  const packetFields = packets.map((packet) => {\n    const raw = packet?.extraction ?? {};\n    const document = raw.ExtractionResult?.ResultsDocument\n      ?? raw.extractionResult?.resultsDocument\n      ?? raw.ResultsDocument\n      ?? raw;\n    return {\n      sourceDocumentId: packet?.sourceDocumentId ?? '',\n      fields: Array.isArray(document?.Fields)\n        ? document.Fields\n        : Array.isArray(document?.fields) ? document.fields : [],\n      extraction: raw,\n    };\n  });\n  const allFields = packetFields.flatMap((packet) => packet.fields.map((field) => ({\n    field,\n    sourceDocumentId: packet.sourceDocumentId,\n  })));\n  const fieldEntry = (names) => {\n    const wanted = names.map(normalizeKey);\n    return allFields.find(({ field }) => wanted.includes(normalizeKey(\n      field?.FieldName ?? field?.fieldName ?? field?.Name ?? field?.name,\n    )));\n  };\n  const scalar = (value, fallback = '') => {\n    if (value === undefined || value === null || value === '') return fallback;\n    if (typeof value === 'object') return value.Value ?? value.value ?? fallback;\n    return value;\n  };\n  const firstValue = (names, fallback = '') => {\n    const item = fieldEntry(names)?.field;\n    return scalar(item?.Value ?? item?.value ?? item?.Values?.[0] ?? item?.values?.[0], fallback);\n  };\n  const numberValue = (names, fallback = 0) => {\n    const value = Number(String(firstValue(names, fallback)).replace(/[$,]/g, ''));\n    return Number.isFinite(value) ? value : fallback;\n  };\n  const readRow = (source, names, fallback = '') => {\n    for (const name of names) {\n      const candidate = Array.isArray(source)\n        ? source.find((item) => normalizeKey(\n          item?.FieldName ?? item?.fieldName ?? item?.Name ?? item?.name,\n        ) === normalizeKey(name))\n        : source?.[name];\n      const value = scalar(candidate?.Value ?? candidate?.value ?? candidate, undefined);\n      if (value !== undefined && value !== null && value !== '') return value;\n    }\n    return fallback;\n  };\n  const canonicalCharges = [];\n  for (const packet of packetFields) {\n    const lineItemField = packet.fields.find((item) => [\n      'lineitems', 'invoicelineitems', 'charges',\n    ].includes(normalizeKey(item?.FieldName ?? item?.fieldName ?? item?.Name ?? item?.name)));\n    const rows = lineItemField?.Values ?? lineItemField?.values\n      ?? lineItemField?.Rows ?? lineItemField?.rows ?? [];\n    for (const [index, row] of rows.entries()) {\n      const source = row?.Values ?? row?.values ?? row;\n      const quantity = Number(readRow(source, ['Quantity'], 1));\n      const unitRate = Number(String(readRow(source, ['UnitRate', 'Rate'], 0)).replace(/[$,]/g, ''));\n      const submittedAmount = Number(String(readRow(\n        source,\n        ['SubmittedAmount', 'Amount', 'LineTotal'],\n        quantity * unitRate,\n      )).replace(/[$,]/g, ''));\n      const chargeId = String(readRow(\n        source,\n        ['ChargeId', 'LineId'],\n        `charge-${canonicalCharges.length + 1}`,\n      ));\n      canonicalCharges.push({\n        chargeId,\n        externalRecordId: chargeId,\n        sourceDocumentId: String(readRow(source, ['SourceDocumentId'], packet.sourceDocumentId)),\n        sourceDocumentType: 'invoice',\n        category: String(readRow(source, ['Category'], 'unclassified')),\n        description: String(readRow(source, ['Description', 'Item'], 'Extracted invoice line')),\n        serviceDate: String(readRow(source, ['ServiceDate'], firstValue(['InvoiceDate'], ''))),\n        quantity: Number.isFinite(quantity) ? quantity : 1,\n        unit: String(readRow(source, ['Unit'], 'each')),\n        unitRate: Number.isFinite(unitRate) ? unitRate : 0,\n        submittedAmount: Number.isFinite(submittedAmount) ? submittedAmount : 0,\n        evidenceTypes: [],\n      });\n    }\n  }\n  const invoiceTotal = numberValue(['InvoiceTotal', 'TotalAmount', 'Total']);\n  const registerTotal = numberValue(['RegisterTotal', 'CostRegisterTotal'], invoiceTotal);\n  const sourceDocumentIds = $vars.validateSubmission.output.sourceDocumentIds ?? [];\n  return {\n    invoice: {\n      number: String(firstValue(['InvoiceNumber', 'InvoiceNo'], '')),\n      total: invoiceTotal,\n      date: String(firstValue(['InvoiceDate', 'Date'], '')).slice(0, 10),\n    },\n    supplier: {\n      name: String(firstValue(\n        ['SupplierName', 'VendorName', 'Supplier'],\n        'Northbridge General Contractors',\n      )),\n    },\n    accountId: $vars.validateSubmission.output.accountId\n      ?? 'account-lakeshore-regional-health-system',\n    projectId: $vars.validateSubmission.output.projectId\n      ?? 'project-west-pavilion-renovation',\n    register: { total: registerTotal, lines: [] },\n    supportingInvoices: [],\n    canonicalCharges,\n    documents: sourceDocumentIds.map((documentId) => ({\n      documentId,\n      bucketPath: documentId,\n      displayName: String(documentId).split('/').at(-1) ?? documentId,\n      documentType: 'invoice-support',\n      checksum: '',\n    })),\n    currency: String(firstValue(['Currency'], 'USD')),\n    extractionResults: packets,\n  };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Canonical package from all IXP results",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Normalization error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "lookupProjectCost",
      "type": "uipath.core.api-workflow.8cb92544-1799-40af-91b2-6e2f3085fe69",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Lookup project cost",
        "icon": "api"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "contractProfileId": "=js:$vars.validateSubmission.output.contractProfileId",
        "accountId": "=js:$vars.normalizePackage.output.accountId",
        "projectId": "=js:$vars.normalizePackage.output.projectId",
        "supplier": "=js:$vars.normalizePackage.output.supplier",
        "invoice": "=js:$vars.normalizePackage.output.invoice",
        "register": "=js:$vars.normalizePackage.output.register",
        "supportingInvoices": "=js:$vars.normalizePackage.output.supportingInvoices",
        "simulateSearchUnavailable": "=js:$vars.validateSubmission.output.simulateSearchUnavailable",
        "errorHandlingEnabled": false
      },
      "outputs": {

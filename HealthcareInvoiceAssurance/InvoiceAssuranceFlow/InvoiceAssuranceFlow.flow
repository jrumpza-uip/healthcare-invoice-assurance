      {
        "id": "analyzeContract.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "governingDocumentStack": {
              "type": "array",
              "description": "Effective indexed documents with topic scope and applicability reasons",
              "items": {
                "type": "object",
                "properties": {
                  "sourceDocumentId": {
                    "type": "string"
                  },
                  "documentTitle": {
                    "type": "string"
                  },
                  "effectiveDate": {
                    "type": "string",
                    "nullable": true
                  },
                  "topicScope": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceDocumentId",
                  "documentTitle",
                  "topicScope",
                  "reason"
                ]
              }
            },
            "normalizedRules": {
              "type": "array",
              "description": "Grounded supported rules for deterministic evaluation",
              "items": {
                "type": "object",
                "properties": {
                  "ruleId": {
                    "type": "string"
                  },
                  "ruleType": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "object"
                  },
                  "operands": {
                    "type": "object"
                  },
                  "effectivePeriod": {
                    "type": "object"
                  },
                  "sourceDocumentId": {
                    "type": "string"
                  },
                  "sourceClause": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  }
                },
                "required": [
                  "ruleId",
                  "ruleType",
                  "scope",
                  "operands",
                  "effectivePeriod",
                  "sourceDocumentId",
                  "sourceClause",
                  "confidence"
                ]
              }
            },
            "proposedFindings": {
              "type": "array",
              "description": "Exception-only charge-to-rule associations. Include only exceeded limits or caps, excluded categories, missing required evidence, or non-zero reconciliation exceptions. Never include supported, compliant, satisfied, tied, or unchanged items; use an empty array when no exception exists.",
              "items": {
                "type": "object",
                "properties": {
                  "findingId": {
                    "type": "string"
                  },
                  "chargeId": {
                    "type": "string"
                  },
                  "ruleId": {
                    "type": "string"
                  },
                  "evidenceState": {
                    "type": "string",
                    "enum": [
                      "exceededLimit",
                      "exceededCap",
                      "excludedCategory",
                      "missingEvidence",
                      "reconciliationException"
                    ],
                    "description": "Exception state only. Never infer missingEvidence from an empty evidenceTypes array unless a retrieved category-specific EvidenceRequirement expressly requires an input evidence type and its threshold applies."
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceDocumentId": {
                          "type": "string"
                        },
                        "sourceClause": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceDocumentId",
                        "sourceClause"
                      ]
                    }
                  }
                },
                "required": [
                  "findingId",
                  "chargeId",
                  "ruleId",
                  "evidenceState",
                  "explanation",
                  "citations"
                ]
              }
            },
            "ambiguities": {
              "type": "array",
              "description": "Only conflicting applicability, absent contract support, or unsupported rule concepts that block a relevant decision. Do not use for compliant values, resolved evidence, tied reconciliation, or generic charges.",
              "items": {
                "type": "object",
                "properties": {
                  "ambiguityId": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "affectedChargeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceDocumentId": {
                          "type": "string"
                        },
                        "sourceClause": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceDocumentId",
                        "sourceClause"
                      ]
                    }
                  }
                },
                "required": [
                  "ambiguityId",
                  "topic",
                  "explanation",
                  "affectedChargeIds",
                  "citations"
                ]
              }
            },
            "analysisSummary": {
              "type": "string",
              "description": "Concise non-legal explanation of governing rules, proposals, and open ambiguity"
            },
            "schemaVersion": {
              "type": "string",
              "description": "Agent output contract version"
            }
          }
        },
        "binding": {
          "nodeId": "analyzeContract",
          "outputId": "output"
        }
      },
      {
        "id": "analyzeContract.error",
        "type": "object",
        "description": "Error information if the node fails",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": [
            "code",
            "message",
            "detail",
            "category",
            "status"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "Error code as a string"
            },
            "message": {
              "type": "string",
              "description": "High-level error message"
            },
            "detail": {
              "type": "string",
              "description": "Detailed error description"
            },
            "category": {
              "type": "string",
              "description": "Error category"
            },
            "status": {
              "type": "integer",
              "description": "HTTP status code"
            }
          },
          "additionalProperties": false
        },
        "binding": {
          "nodeId": "analyzeContract",
          "outputId": "error"
        }
      },
      {
        "id": "evaluateFinancials.output",
        "type": "object",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "valid",
                "invalid",
                "technicalError"
              ],
              "title": "Status",
              "type": "string"
            },
            "authoritativeFindings": {
              "items": {
                "properties": {
                  "findingId": {
                    "title": "Findingid",
                    "type": "string"
                  },
                  "chargeId": {
                    "title": "Chargeid",
                    "type": "string"
                  },
                  "ruleId": {
                    "title": "Ruleid",
                    "type": "string"
                  },
                  "ruleType": {
                    "title": "Ruletype",
                    "type": "string"
                  },
                  "status": {
                    "title": "Status",
                    "type": "string"
                  },
                  "submittedAmount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Submittedamount"
                  },
                  "allowedAmount": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Allowedamount"
                  },
                  "adjustment": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Adjustment"
                  },
                  "sourceDocumentId": {
                    "title": "Sourcedocumentid",
                    "type": "string"
                  },
                  "sourceClause": {
                    "title": "Sourceclause",
                    "type": "string"
                  }
                },
                "required": [
                  "findingId",
                  "chargeId",
                  "ruleId",
                  "ruleType",
                  "status",
                  "submittedAmount",
                  "allowedAmount",
                  "adjustment",
                  "sourceDocumentId",
                  "sourceClause"
                ],
                "title": "AuthoritativeFinding",
                "type": "object"
              },
              "title": "Authoritativefindings",
              "type": "array"
            },

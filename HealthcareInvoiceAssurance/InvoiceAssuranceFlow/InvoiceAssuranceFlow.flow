    "reevaluateAffectedFindings": {
      "nodes": [
        {
          "id": "reevaluateStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start",
            "icon": "play"
          },
          "inputs": {
            "entryPointId": "c0736236-a9a3-440f-8976-873ffa1c01b4",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Targeted re-evaluation inputs",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "applyReviewerChanges",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Apply reviewer changes",
            "icon": "code"
          },
          "inputs": {
            "script": "const input = $vars.reevaluateStart.output ?? {};\n  const previous = input.previousSnapshot ?? {};\n  const decision = input.reviewerDecision ?? {};\n  const findings = Array.isArray(previous.authoritativeFindings)\n    ? previous.authoritativeFindings\n    : [];\n  const evidence = Array.isArray(decision.uploadedEvidence) ? decision.uploadedEvidence : [];\n  const evidenceFindingIds = evidence.length > 0 && decision.evidenceStatus === 'Resolved'\n    ? findings\n      .filter((finding) => finding.evidenceState === 'missingEvidence')\n      .map((finding) => finding.findingId)\n    : [];\n  const affectedChargeIds = new Set(findings\n    .filter((finding) => evidenceFindingIds.includes(finding.findingId))\n    .map((finding) => finding.chargeId)\n    .filter(Boolean));\n  const canonicalCharges = (previous.lineItems ?? input.canonicalCharges ?? []).map((charge) => ({\n    ...charge,\n    evidenceTypes: affectedChargeIds.has(charge.chargeId)\n      ? [...new Set([...(charge.evidenceTypes ?? []), 'itemized-receipt'])]\n      : [...(charge.evidenceTypes ?? [])],\n  }));\n  const documents = [\n    ...(previous.documents ?? input.documents ?? []),\n    ...evidence.map((item) => ({\n      documentId: item.evidenceId ?? item.bucketPath,\n      bucketPath: item.bucketPath,\n      displayName: item.displayName ?? item.bucketPath,\n      documentType: 'supporting-evidence',\n      checksum: item.checksum ?? '',\n    })),\n  ];\n  const comparison = input.reconciliationSummary?.invoiceRegisterComparison ?? {};\n  const correctedRegisterAmount = Number(decision.correctedRegisterAmount);\n  const hasCorrection = Number.isFinite(correctedRegisterAmount)\n    && decision.registerCorrectionReason?.trim();\n  const invoiceTotal = Number(comparison.invoiceTotal ?? previous.invoiceSummary?.submittedTotal ?? 0);\n  const variance = hasCorrection ? invoiceTotal - correctedRegisterAmount : Number(comparison.variance ?? 0);\n  const reconciliationSummary = {\n    ...(input.reconciliationSummary ?? {}),\n    invoiceRegisterComparison: {\n      ...comparison,\n      ...(hasCorrection ? {\n        registerTotal: correctedRegisterAmount,\n        variance,\n        status: Math.abs(variance) <= 0.01 ? 'Tied' : 'Variance',\n        correctionReason: decision.registerCorrectionReason,\n      } : {}),\n    },\n  };\n  const reconciliationFindingIds = hasCorrection\n    ? findings\n      .filter((finding) => finding.evidenceState === 'reconciliationException')\n      .map((finding) => finding.findingId)\n    : [];\n  const requestedIds = Array.isArray(decision.changedFindingIds)\n    ? decision.changedFindingIds\n    : [];\n  let changedFindingIds = [...new Set([\n    ...requestedIds,\n    ...evidenceFindingIds,\n    ...reconciliationFindingIds,\n  ].filter(Boolean))];\n  if (changedFindingIds.length === 0) {\n    changedFindingIds = findings.map((finding) => finding.findingId).filter(Boolean);\n  }\n  return {\n    ...input,\n    canonicalCharges,\n    documents,\n    reconciliationSummary,\n    changedFindingIds,\n    humanOverride: decision.reviewerNotes ?? input.humanOverride ?? null,\n    reviewerDecision: decision,\n    previousSnapshot: previous,\n    priorActivity: previous.activity ?? input.priorActivity ?? [],\n  };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Reviewer-adjusted re-evaluation inputs",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Reviewer change application error",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "reanalyzeChangedFindings",
          "type": "uipath.core.agent.7147dad8-2ef2-4d99-9af6-bafbc4c24a91",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Reanalyze changed findings",
            "icon": "autonomous-agent"
          },
          "inputs": {
            "correlationId": "=js:$vars.applyReviewerChanges.output.correlationId",
            "invoiceRecordId": "=js:$vars.applyReviewerChanges.output.invoiceRecordId",
            "contractProfileId": "=js:$vars.applyReviewerChanges.output.contractProfileId",
            "invoiceDate": "=js:$vars.applyReviewerChanges.output.invoiceDate",
            "canonicalCharges": "=js:$vars.applyReviewerChanges.output.canonicalCharges",
            "reconciliationSummary": "=js:$vars.applyReviewerChanges.output.reconciliationSummary",
            "precedencePolicy": "=js:$vars.applyReviewerChanges.output.precedencePolicy",
            "humanOverride": "=js:$vars.applyReviewerChanges.output.humanOverride",
            "changedFindingIds": "=js:$vars.applyReviewerChanges.output.changedFindingIds",
            "errorHandlingEnabled": false
          },
          "outputs": {
            "output": {
              "type": "object",
              "schema": {
                "type": "object",
                "properties": {
                  "governingDocumentStack": {
                    "type": "array",
                    "description": "Effective indexed documents with topic scope and applicability reasons",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceDocumentId": {
                          "type": "string"
                        },
                        "documentTitle": {
                          "type": "string"
                        },
                        "effectiveDate": {
                          "type": "string",
                          "nullable": true
                        },
                        "topicScope": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceDocumentId",
                        "documentTitle",
                        "topicScope",
                        "reason"
                      ]
                    }
                  },
                  "normalizedRules": {
                    "type": "array",
                    "description": "Grounded supported rules for deterministic evaluation",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ruleId": {
                          "type": "string"
                        },
                        "ruleType": {
                          "type": "string"
                        },
                        "scope": {
                          "type": "object"
                        },
                        "operands": {
                          "type": "object"
                        },
                        "effectivePeriod": {
                          "type": "object"
                        },
                        "sourceDocumentId": {
                          "type": "string"
                        },
                        "sourceClause": {
                          "type": "string"
                        },
                        "confidence": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "ruleId",
                        "ruleType",
                        "scope",
                        "operands",
                        "effectivePeriod",
                        "sourceDocumentId",
                        "sourceClause",
                        "confidence"
                      ]
                    }
                  },
                  "proposedFindings": {
                    "type": "array",
                    "description": "Exception-only charge-to-rule associations. Include only exceeded limits or caps, excluded categories, missing required evidence, or non-zero reconciliation exceptions. Never include supported, compliant, satisfied, tied, or unchanged items; use an empty array when no exception exists.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "findingId": {
                          "type": "string"
                        },
                        "chargeId": {
                          "type": "string"
                        },
                        "ruleId": {
                          "type": "string"
                        },
                        "evidenceState": {
                          "type": "string",
                          "enum": [
                            "exceededLimit",
                            "exceededCap",
                            "excludedCategory",
                            "missingEvidence",
                            "reconciliationException"
                          ],
                          "description": "Exception state only. Never infer missingEvidence from an empty evidenceTypes array unless a retrieved category-specific EvidenceRequirement expressly requires an input evidence type and its threshold applies."
                        },
                        "explanation": {
                          "type": "string"
                        },
                        "citations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "sourceDocumentId": {
                                "type": "string"
                              },
                              "sourceClause": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "sourceDocumentId",
                              "sourceClause"
                            ]
                          }
                        }
                      },
                      "required": [
                        "findingId",
                        "chargeId",
                        "ruleId",
                        "evidenceState",
                        "explanation",
                        "citations"
                      ]
                    }
                  },
                  "ambiguities": {
                    "type": "array",
                    "description": "Only conflicting applicability, absent contract support, or unsupported rule concepts that block a relevant decision. Do not use for compliant values, resolved evidence, tied reconciliation, or generic charges.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ambiguityId": {
                          "type": "string"
                        },
                        "topic": {
                          "type": "string"
                        },
                        "explanation": {
                          "type": "string"
                        },
                        "affectedChargeIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "citations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "sourceDocumentId": {
                                "type": "string"
                              },
                              "sourceClause": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "sourceDocumentId",
                              "sourceClause"
                            ]
                          }
                        }
                      },
                      "required": [
                        "ambiguityId",
                        "topic",
                        "explanation",
                        "affectedChargeIds",
                        "citations"
                      ]
                    }
                  },
                  "analysisSummary": {
                    "type": "string",

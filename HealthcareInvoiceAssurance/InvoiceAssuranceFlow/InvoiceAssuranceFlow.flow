        {
          "id": "assessReadiness",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Assess approval readiness",
            "icon": "code"
          },
          "inputs": {
            "script": "const input = $vars.applyReviewerChanges.output ?? {}; const evaluation = $vars.reevaluateFinancials?.output ?? {}; const snapshot = evaluation.financialSnapshot ?? {}; const findings = evaluation.authoritativeFindings ?? []; const unresolved = findings.filter((finding) => ['pendingEvidence', 'technicalError', 'ambiguous'].includes(finding.status) || finding.evidenceState === 'missingEvidence'); const awaitingEvidence = unresolved.some((finding) => finding.evidenceState === 'missingEvidence'); const readiness = input.reviewerDecision?.reviewReady === true && evaluation.status === 'valid' && unresolved.length === 0; const analysisVersion = Number(snapshot.version ?? Number(input.previousSnapshot?.analysisVersion ?? 1) + 1); const reviewCycle = Number(input.previousSnapshot?.reviewCycle ?? 1) + 1; const lineItems = (input.canonicalCharges ?? []).map((charge) => { const chargeFindings = findings.filter((finding) => finding.chargeId === charge.chargeId); const adjustment = chargeFindings.reduce((maximum, finding) => Math.max(maximum, Number(finding.adjustment ?? 0)), 0); const evaluationStatus = chargeFindings.some((finding) => ['pendingEvidence', 'technicalError', 'ambiguous'].includes(finding.status)) ? 'NeedsReview' : adjustment > 0 ? 'Adjusted' : 'Allowed'; return { ...charge, allowedAmount: Math.max(0, Number(charge.submittedAmount ?? 0) - adjustment), adjustment, evaluationStatus }; }); const lineRecords = lineItems.map((charge) => ({ InvoiceRecordId: input.invoiceRecordId, SourceDocumentId: charge.sourceDocumentId ?? '', SourceDocumentType: charge.sourceDocumentType ?? 'invoice', Description: charge.description ?? '', Category: charge.category ?? 'unclassified', Quantity: Number(charge.quantity ?? 1), Unit: charge.unit ?? 'each', SubmittedRate: Number(charge.unitRate ?? 0), SubmittedAmount: Number(charge.submittedAmount ?? 0), IxpConfidence: Number(charge.ixpConfidence ?? 0), SourceCoordinatesJson: JSON.stringify(charge.sourceCoordinates ?? {}), ExternalRecordId: charge.externalRecordId ?? charge.chargeId ?? '', ExternalMatchStatus: charge.externalMatchStatus ?? 'NotMatched', ExternalAmount: Number(charge.externalAmount ?? 0), Variance: Number(charge.variance ?? 0), AllowedAmount: Number(charge.allowedAmount ?? 0), Adjustment: Number(charge.adjustment ?? 0), EvaluationStatus: charge.evaluationStatus ?? 'NeedsReview', AnalysisVersion: analysisVersion })); const timestamp = new Date().toISOString(); const activityEntry = { eventTimestamp: timestamp, eventName: 'Targeted re-evaluation completed', eventType: 'AnalysisVersionCreated', summary: readiness ? 'Ready for manager review' : 'Additional reviewer work required' }; const activity = [...(Array.isArray(input.priorActivity) ? input.priorActivity : []), activityEntry]; return { ...evaluation, analysisVersion, reviewCycle, readiness, authoritativeFindings: findings, lineItems, lineRecords, documents: Array.isArray(input.documents) ? input.documents : [], mainRecord: { ProcessingStatus: readiness ? 'ManagerPending' : awaitingEvidence ? 'AwaitingEvidence' : 'ReviewerPending', SubmittedTotal: Number(snapshot.submittedTotal ?? 0), AdjustmentTotal: Number(snapshot.totalAdjustment ?? 0), PayableTotal: Number(snapshot.proposedPayable ?? 0), OpenFindingCount: unresolved.length, AwaitingEvidence: awaitingEvidence, AnalysisVersion: analysisVersion, FindingsJson: JSON.stringify(findings) }, activityRecord: { InvoiceRecordId: input.invoiceRecordId, CorrelationId: input.correlationId, EventTimestamp: timestamp, EventName: 'Targeted re-evaluation completed', EventType: 'AnalysisVersionCreated', EventSource: 'InvoiceAssuranceFlow.reevaluateAffectedFindings', Summary: activityEntry.summary, PayloadJson: JSON.stringify({ analysisVersion, reviewCycle, readiness, changedFindingIds: input.changedFindingIds ?? [], priorSnapshot: input.previousSnapshot ?? {}, snapshot, findings }) }, invoiceSummary: { ...(input.previousSnapshot?.invoiceSummary ?? {}), submittedTotal: Number(snapshot.submittedTotal ?? 0), currentAdjustment: Number(snapshot.totalAdjustment ?? 0), currentPayable: Number(snapshot.proposedPayable ?? 0), openFindingCount: unresolved.length, awaitingEvidence }, activity };"
          },
          "outputs": {
            "output": {
              "type": "any",
              "description": "Re-evaluation readiness result",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Readiness evaluation error",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "persistReevaluationRecords",
          "type": "uipath.core.rpa-workflow.dd273b1c-d925-45d0-b1b6-b719cd972819",
          "typeVersion": "1.0.0",

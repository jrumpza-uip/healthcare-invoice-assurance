{
  "id": "c32bb746-0a7a-4a81-ac02-b187fc449894",
  "version": "1.9",
  "name": "InvoiceAssuranceFlow",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "29947b52-8efc-46ad-a223-b463d807a0cb",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "validateSubmission",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate submission"
      },
      "inputs": {
        "script": "const submission = $vars.start.output ?? {}; const required = ['invoiceRecordId', 'correlationId', 'contractProfileId']; const missing = required.filter((name) => typeof submission[name] !== 'string' || submission[name].trim() === ''); if (!Array.isArray(submission.sourceDocumentIds) || submission.sourceDocumentIds.length === 0) missing.push('sourceDocumentIds'); if (missing.length > 0) throw new Error(`Invalid submission: ${missing.join(', ')} required`); return { invoiceRecordId: submission.invoiceRecordId.trim(), correlationId: submission.correlationId.trim(), contractProfileId: submission.contractProfileId.trim(), sourceDocumentIds: submission.sourceDocumentIds.filter(Boolean), primaryDocumentId: submission.sourceDocumentIds.find(Boolean), humanOverride: submission.humanOverride ?? null, changedFindingIds: Array.isArray(submission.changedFindingIds) ? submission.changedFindingIds : [], simulateSearchUnavailable: submission.simulateSearchUnavailable === true, precedencePolicy: { mode: 'topic-specific', effectiveOnOrBeforeInvoiceDate: true } };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Validated submission context",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Submission validation error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "markProcessing",
      "type": "core.subflow",
      "typeVersion": "1.0",
      "display": {
        "label": "Mark processing"
      },
      "inputs": {
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "eventName": "Processing started",
        "eventType": "ProcessingStatusChanged",
        "eventSource": "InvoiceAssuranceFlow.markProcessing",
        "summary": "Invoice assurance processing started",
        "payloadJson": "=js:JSON.stringify({ processingStatus: 'Processing', sourceDocumentIds: $vars.validateSubmission.output.sourceDocumentIds })"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Persisted processing state and activity identifiers",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Persistence error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "extractPackage",
      "type": "uipath.ixp.healthcare-invoice-assurance-51392a38-ixp.3994ca7a-2b93-807c-8f96-75602d7b1c47-79d872b0-bee1-4264-a6de-3e780f4e4239",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract package"
      },
      "inputs": {
        "model": {
          "id": "3994ca7a-2b93-807c-8f96-75602d7b1c47",
          "modelName": "healthcare-invoice-assurance-51392a38-ixp",
          "modelDisplayName": "Healthcare Invoice Assurance",
          "folderKey": "79d872b0-bee1-4264-a6de-3e780f4e4239",
          "folderName": "AMER Presales/HLS",
          "folderPath": "8c19eac9-14be-4021-a784-70e216fd684f.79d872b0-bee1-4264-a6de-3e780f4e4239",
          "description": ""
        },
        "modelName": "healthcare-invoice-assurance-51392a38-ixp",
        "description": "",
        "projectName": "healthcare-invoice-assurance-51392a38-ixp",
        "versionTag": "25",
        "folderKey": "79d872b0-bee1-4264-a6de-3e780f4e4239",
        "folderName": "AMER Presales/HLS",
        "fileRef": "=js:$vars.validateSubmission.output.primaryDocumentId",
        "pageRange": "",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Published IXP extraction result",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "IXP extraction error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "normalizeCharges",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize charges"
      },
      "inputs": {
        "script": "const raw = $vars.extractPackage.output ?? {}; const document = raw.ExtractionResult?.ResultsDocument ?? raw.extractionResult?.resultsDocument ?? raw.ResultsDocument ?? raw; const fields = Array.isArray(document.Fields) ? document.Fields : Array.isArray(document.fields) ? document.fields : []; const normalizeKey = (value) => String(value ?? '').toLowerCase().replace(/[^a-z0-9]/g, ''); const field = (names) => fields.find((item) => names.map(normalizeKey).includes(normalizeKey(item.FieldName ?? item.fieldName ?? item.Name ?? item.name))); const firstValue = (names, fallback = '') => { const item = field(names); return item?.Value ?? item?.value ?? item?.Values?.[0]?.Value ?? item?.values?.[0]?.value ?? fallback; }; const numberValue = (names, fallback = 0) => { const value = Number(String(firstValue(names, fallback)).replace(/[$,]/g, '')); return Number.isFinite(value) ? value : fallback; }; const lineItemField = field(['LineItems', 'InvoiceLineItems', 'Charges']); const rows = lineItemField?.Values ?? lineItemField?.values ?? lineItemField?.Rows ?? lineItemField?.rows ?? []; const canonicalCharges = rows.map((row, index) => { const source = row?.Values ?? row?.values ?? row; const read = (names, fallback = '') => { for (const name of names) { const candidate = Array.isArray(source) ? source.find((item) => normalizeKey(item.FieldName ?? item.fieldName ?? item.Name ?? item.name) === normalizeKey(name)) : source?.[name]; const value = candidate?.Value ?? candidate?.value ?? candidate; if (value !== undefined && value !== null && value !== '') return value; } return fallback; }; const quantity = Number(read(['Quantity'], 1)); const unitRate = Number(String(read(['UnitRate', 'Rate'], 0)).replace(/[$,]/g, '')); const submittedAmount = Number(String(read(['SubmittedAmount', 'Amount', 'LineTotal'], quantity * unitRate)).replace(/[$,]/g, '')); return { chargeId: String(read(['ChargeId', 'LineId'], `charge-${index + 1}`)), sourceDocumentId: String(read(['SourceDocumentId'], $vars.validateSubmission.output.primaryDocumentId)), category: String(read(['Category'], 'unclassified')), description: String(read(['Description', 'Item'], 'Extracted invoice line')), serviceDate: String(read(['ServiceDate'], firstValue(['InvoiceDate'], ''))), quantity: Number.isFinite(quantity) ? quantity : 1, unit: String(read(['Unit'], 'each')), unitRate: Number.isFinite(unitRate) ? unitRate : 0, submittedAmount: Number.isFinite(submittedAmount) ? submittedAmount : 0, evidenceTypes: [] }; }); const invoiceTotal = numberValue(['InvoiceTotal', 'TotalAmount', 'Total']); const registerTotal = numberValue(['RegisterTotal', 'CostRegisterTotal'], invoiceTotal); const invoiceDate = String(firstValue(['InvoiceDate', 'Date'], '')).slice(0, 10); const supplierName = String(firstValue(['SupplierName', 'VendorName', 'Supplier'], 'Northbridge General Contractors')); const invoiceNumber = String(firstValue(['InvoiceNumber', 'InvoiceNo'], '')); return { invoice: { number: invoiceNumber, total: invoiceTotal, date: invoiceDate }, supplier: { name: supplierName }, accountId: 'account-lakeshore-regional-health-system', projectId: 'project-west-pavilion-renovation', register: { total: registerTotal, lines: [] }, supportingInvoices: [], canonicalCharges, documents: $vars.validateSubmission.output.sourceDocumentIds.map((documentId) => ({ documentId, bucketPath: documentId, displayName: documentId, documentType: 'invoice-support', checksum: '' })), currency: String(firstValue(['Currency'], 'USD')), extraction: raw };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Canonical invoice package derived from IXP output",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Normalization error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "lookupProjectCost",
      "type": "uipath.core.api-workflow.8cb92544-1799-40af-91b2-6e2f3085fe69",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Lookup project cost"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "contractProfileId": "=js:$vars.validateSubmission.output.contractProfileId",
        "accountId": "=js:$vars.normalizeCharges.output.accountId",
        "projectId": "=js:$vars.normalizeCharges.output.projectId",
        "supplier": "=js:$vars.normalizeCharges.output.supplier",
        "invoice": "=js:$vars.normalizeCharges.output.invoice",
        "register": "=js:$vars.normalizeCharges.output.register",
        "supportingInvoices": "=js:$vars.normalizeCharges.output.supportingInvoices",
        "simulateSearchUnavailable": "=js:$vars.validateSubmission.output.simulateSearchUnavailable"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Project-cost reconciliation result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "API Workflow error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contractGovernedGate",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Contract governed gate"
      },
      "inputs": {
        "expression": "=js:$vars.validateSubmission.output.contractProfileId === 'profile-west-pavilion' && $vars.lookupProjectCost.output?.searchStatus !== 'SearchIncomplete'",
        "trueLabel": "Governed",
        "falseLabel": "Technical review"
      }
    },
    {
      "id": "analyzeContract",
      "type": "uipath.core.agent.7147dad8-2ef2-4d99-9af6-bafbc4c24a91",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Analyze contract"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "contractProfileId": "=js:$vars.validateSubmission.output.contractProfileId",
        "invoiceDate": "=js:$vars.canonicalPackage.invoice?.date ?? ''",
        "canonicalCharges": "=js:$vars.normalizeCharges.output.canonicalCharges",
        "reconciliationSummary": "=js:$vars.lookupProjectCost.output",
        "precedencePolicy": "=js:$vars.validateSubmission.output.precedencePolicy",
        "humanOverride": "=js:$vars.validateSubmission.output.humanOverride",
        "changedFindingIds": "=js:$vars.validateSubmission.output.changedFindingIds",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "evaluateFinancials",
      "type": "uipath.core.function.88ef616e-4e9d-4dba-90b3-beb53b5581d2",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Evaluate financials"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "analysisVersion": 1,
        "mode": "initial",
        "currency": "=js:$vars.normalizeCharges.output.currency",
        "invoiceSubmittedTotal": "=js:String($vars.normalizeCharges.output.invoice.total)",
        "canonicalCharges": "=js:$vars.normalizeCharges.output.canonicalCharges",
        "normalizedRules": "=js:$vars.analyzeContract.output.normalizedRules",
        "proposedFindings": "=js:$vars.analyzeContract.output.proposedFindings",
        "reconciliationResult": "=js:JSON.stringify($vars.lookupProjectCost.output ?? {})",
        "previousSnapshot": "{}",
        "changedFindingIds": "=js:$vars.validateSubmission.output.changedFindingIds",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "persistInitialAnalysis",
      "type": "core.subflow",
      "typeVersion": "1.0",
      "display": {
        "label": "Persist initial analysis"
      },
      "inputs": {
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "analysis": "=js:$vars.analyzeContract.output",
        "evaluation": "=js:$vars.evaluateFinancials.output",
        "canonicalPackage": "=js:$vars.normalizeCharges.output",
        "sourceDocumentIds": "=js:$vars.validateSubmission.output.sourceDocumentIds",
        "technicalContext": "=js:({ unsupportedProfile: $vars.validateSubmission.output.contractProfileId !== 'profile-west-pavilion', searchStatus: $vars.lookupProjectCost.output?.searchStatus ?? '', extractionError: $vars.extractPackage.error ?? null, lookupError: $vars.lookupProjectCost.error ?? null, agentError: $vars.analyzeContract.error ?? null, evaluationError: $vars.evaluateFinancials.error ?? null })",
        "eventName": "Initial analysis persisted",
        "eventType": "AnalysisVersionCreated",
        "eventSource": "InvoiceAssuranceFlow.persistInitialAnalysis"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Persisted initial analysis view",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Persistence error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "reviewerTask",
      "type": "uipath.human-in-the-loop.coded-action-app",
      "typeVersion": "1.0",
      "display": {
        "label": "Reviewer task"
      },
      "inputs": {

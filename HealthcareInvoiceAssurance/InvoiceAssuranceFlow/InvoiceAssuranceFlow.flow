              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "description": "Project-cost reconciliation result",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "analyzeContract",
      "type": "uipath.core.agent.7147dad8-2ef2-4d99-9af6-bafbc4c24a91",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Analyze contract",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "contractProfileId": "=js:$vars.validateSubmission.output.contractProfileId",
        "invoiceDate": "=js:$vars.normalizePackage.output.invoice?.date ?? ''",
        "canonicalCharges": "=js:$vars.normalizePackage.output.canonicalCharges",
        "reconciliationSummary": "=js:$vars.lookupProjectCost.output",
        "precedencePolicy": "=js:$vars.validateSubmission.output.precedencePolicy",
        "humanOverride": "=js:null",
        "changedFindingIds": "=js:[]",
        "errorHandlingEnabled": false
      },
      "outputs": {
        "output": {
          "type": "object",
          "schema": {
            "type": "object",
            "properties": {
              "governingDocumentStack": {
                "type": "array",
                "description": "Effective indexed documents with topic scope and applicability reasons",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceDocumentId": {
                      "type": "string"
                    },
                    "documentTitle": {
                      "type": "string"
                    },
                    "effectiveDate": {
                      "type": "string",
                      "nullable": true
                    },
                    "topicScope": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "sourceDocumentId",
                    "documentTitle",
                    "topicScope",
                    "reason"
                  ]
                }
              },
              "normalizedRules": {
                "type": "array",
                "description": "Grounded supported rules for deterministic evaluation",
                "items": {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string"
                    },
                    "ruleType": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "object"
                    },
                    "operands": {
                      "type": "object"
                    },
                    "effectivePeriod": {
                      "type": "object"
                    },
                    "sourceDocumentId": {
                      "type": "string"
                    },
                    "sourceClause": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "ruleId",
                    "ruleType",
                    "scope",
                    "operands",
                    "effectivePeriod",
                    "sourceDocumentId",
                    "sourceClause",
                    "confidence"
                  ]
                }
              },
              "proposedFindings": {
                "type": "array",
                "description": "Exception-only charge-to-rule associations. Include only exceeded limits or caps, excluded categories, missing required evidence, or non-zero reconciliation exceptions. Never include supported, compliant, satisfied, tied, or unchanged items; use an empty array when no exception exists.",
                "items": {
                  "type": "object",
                  "properties": {
                    "findingId": {
                      "type": "string"
                    },
                    "chargeId": {
                      "type": "string"
                    },
                    "ruleId": {
                      "type": "string"
                    },
                    "evidenceState": {
                      "type": "string",
                      "enum": [
                        "exceededLimit",
                        "exceededCap",
                        "excludedCategory",
                        "missingEvidence",
                        "reconciliationException"
                      ],
                      "description": "Exception state only. Never infer missingEvidence from an empty evidenceTypes array unless a retrieved category-specific EvidenceRequirement expressly requires an input evidence type and its threshold applies."
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceDocumentId": {
                            "type": "string"
                          },
                          "sourceClause": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "sourceDocumentId",
                          "sourceClause"
                        ]
                      }
                    }
                  },
                  "required": [
                    "findingId",
                    "chargeId",
                    "ruleId",
                    "evidenceState",
                    "explanation",
                    "citations"
                  ]
                }
              },
              "ambiguities": {
                "type": "array",
                "description": "Only conflicting applicability, absent contract support, or unsupported rule concepts that block a relevant decision. Do not use for compliant values, resolved evidence, tied reconciliation, or generic charges.",
                "items": {
                  "type": "object",
                  "properties": {
                    "ambiguityId": {
                      "type": "string"
                    },
                    "topic": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "affectedChargeIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceDocumentId": {
                            "type": "string"
                          },
                          "sourceClause": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "sourceDocumentId",
                          "sourceClause"
                        ]
                      }
                    }
                  },
                  "required": [
                    "ambiguityId",
                    "topic",
                    "explanation",
                    "affectedChargeIds",
                    "citations"
                  ]
                }
              },
              "analysisSummary": {
                "type": "string",
                "description": "Concise non-legal explanation of governing rules, proposals, and open ambiguity"
              },
              "schemaVersion": {
                "type": "string",
                "description": "Agent output contract version"
              }
            }
          },
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "evaluateFinancials",
      "type": "uipath.core.function.88ef616e-4e9d-4dba-90b3-beb53b5581d2",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Evaluate financials",
        "icon": "function"
      },
      "inputs": {
        "correlationId": "=js:$vars.validateSubmission.output.correlationId",
        "invoiceRecordId": "=js:$vars.validateSubmission.output.invoiceRecordId",
        "analysisVersion": 1,
        "mode": "initial",
        "currency": "=js:$vars.normalizePackage.output.currency",
        "invoiceSubmittedTotal": "=js:String($vars.normalizePackage.output.invoice.total ?? 0)",
        "canonicalCharges": "=js:$vars.normalizePackage.output.canonicalCharges",
        "normalizedRules": "=js:$vars.analyzeContract.output.normalizedRules",
        "proposedFindings": "=js:$vars.analyzeContract.output.proposedFindings",
        "reconciliationResult": "=js:JSON.stringify($vars.lookupProjectCost.output ?? {})",
        "previousSnapshot": "{}",
        "changedFindingIds": "=js:[]",
        "errorHandlingEnabled": false
      },
      "outputs": {
        "output": {
          "type": "object",
          "schema": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "invalid",
                  "technicalError"
                ],
                "title": "Status",
                "type": "string"
              },
              "authoritativeFindings": {
                "items": {
                  "properties": {
                    "findingId": {
                      "title": "Findingid",
                      "type": "string"
                    },
                    "chargeId": {
                      "title": "Chargeid",
                      "type": "string"
                    },
                    "ruleId": {
                      "title": "Ruleid",
                      "type": "string"
                    },
                    "ruleType": {
                      "title": "Ruletype",
                      "type": "string"
                    },
                    "status": {
                      "title": "Status",
                      "type": "string"
                    },
                    "submittedAmount": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Submittedamount"
                    },
                    "allowedAmount": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Allowedamount"
                    },
                    "adjustment": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Adjustment"
                    },
                    "sourceDocumentId": {
                      "title": "Sourcedocumentid",
                      "type": "string"
                    },
                    "sourceClause": {
                      "title": "Sourceclause",
                      "type": "string"
                    }
                  },
                  "required": [
                    "findingId",
                    "chargeId",
                    "ruleId",
                    "ruleType",
                    "status",
                    "submittedAmount",
                    "allowedAmount",
                    "adjustment",
                    "sourceDocumentId",
                    "sourceClause"
                  ],
                  "title": "AuthoritativeFinding",
                  "type": "object"
                },
                "title": "Authoritativefindings",
                "type": "array"
              },
              "calculationLines": {
                "items": {
                  "properties": {
                    "findingId": {
                      "title": "Findingid",
                      "type": "string"
                    },
                    "chargeId": {
                      "title": "Chargeid",
                      "type": "string"
                    },
                    "ruleId": {
                      "title": "Ruleid",
                      "type": "string"
                    },
                    "ruleType": {
                      "title": "Ruletype",
                      "type": "string"
                    },
                    "operands": {
                      "additionalProperties": true,
                      "title": "Operands",
                      "type": "object"
                    },
                    "submittedAmount": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Submittedamount"
                    },
                    "allowedAmount": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Allowedamount"
                    },
                    "adjustment": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                          "type": "string"
                        }
                      ],
                      "title": "Adjustment"
                    },
                    "trace": {
                      "items": {
                        "type": "string"
                      },
                      "title": "Trace",
                      "type": "array"
                    }
                  },
                  "required": [
                    "findingId",
                    "chargeId",
                    "ruleId",
                    "ruleType",
                    "operands",
                    "submittedAmount",
                    "allowedAmount",
                    "adjustment",
                    "trace"
                  ],
                  "title": "CalculationLine",
                  "type": "object"
                },
                "title": "Calculationlines",
                "type": "array"
              },
              "financialSnapshot": {
                "properties": {
                  "submittedTotal": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Submittedtotal"
                  },
                  "totalAdjustment": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Totaladjustment"
                  },
                  "proposedPayable": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Proposedpayable"
                  },
                  "currency": {
                    "title": "Currency",
                    "type": "string"
                  },
                  "version": {
                    "title": "Version",
                    "type": "integer"
                  }
                },
                "required": [
                  "submittedTotal",
                  "totalAdjustment",
                  "proposedPayable",
                  "currency",
                  "version"
                ],
                "title": "FinancialSnapshot",
                "type": "object"
              },
              "reconciliationState": {
                "properties": {
                  "invoiceRegisterStatus": {
                    "default": "",
                    "title": "Invoiceregisterstatus",
                    "type": "string"
                  },
                  "invoiceTotal": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Invoicetotal"
                  },
                  "registerTotal": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Registertotal"
                  },
                  "invoiceRegisterVariance": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Invoiceregistervariance"
                  },
                  "supportingDocumentComparisons": {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "title": "Supportingdocumentcomparisons",
                    "type": "array"
                  }
                },
                "title": "ReconciliationState",
                "type": "object"
              },
              "validationErrors": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "title": "Validationerrors",
                "type": "array"
              },
              "preservedFindingIds": {
                "items": {
                  "type": "string"
                },
                "title": "Preservedfindingids",
                "type": "array"
              },
              "traceVersion": {
                "default": "1.0",
                "title": "Traceversion",
                "type": "string"
              },
              "errorType": {
                "default": "",
                "title": "Errortype",
                "type": "string"
              },
              "errorMessage": {
                "default": "",
                "title": "Errormessage",
                "type": "string"
              }
            }
          },
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",

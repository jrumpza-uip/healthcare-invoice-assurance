          "display": {
            "label": "Prepare reviewer persistence"
          },
          "inputs": {
            "script": "const input = $vars.persistReviewerStart.output; const decision = input.reviewerDecision ?? {}; const dispositions = Array.isArray(decision.findingDispositions) ? decision.findingDispositions : []; const priorFindings = input.priorEvaluation?.authoritativeFindings ?? []; const findings = priorFindings.map((finding) => { const disposition = dispositions.find((item) => item.findingId === finding.findingId); return disposition ? { ...finding, reviewerDisposition: disposition.disposition ?? disposition.status ?? '', reviewerRationale: disposition.rationale ?? decision.reviewerNotes ?? '', evidenceStatus: decision.evidenceStatus ?? finding.evidenceStatus } : finding; }); const awaitingEvidence = decision.reviewReady !== true || decision.evidenceStatus === 'AwaitingEvidence'; return { invoiceRecordId: input.invoiceRecordId, correlationId: input.correlationId, reviewerDecision: decision, changedFindingIds: Array.isArray(decision.changedFindingIds) ? decision.changedFindingIds : [], reviewReady: decision.reviewReady === true, reviewCycle: Number(input.priorEvaluation?.reviewCycle ?? 1), authoritativeFindings: findings, mainRecord: { ProcessingStatus: decision.reviewReady === true ? 'ReviewerComplete' : 'AwaitingEvidence', FindingsJson: JSON.stringify(findings), AwaitingEvidence: awaitingEvidence }, activityRecord: { InvoiceRecordId: input.invoiceRecordId, CorrelationId: input.correlationId, EventTimestamp: new Date().toISOString(), EventName: input.eventName, EventType: input.eventType, EventSource: input.eventSource, Summary: decision.decisionSummary ?? 'Reviewer work recorded', PayloadJson: JSON.stringify(decision) } };"
          },

    "finalizeOutcome": {
      "nodes": [
        {
          "id": "finalizeStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start",
            "icon": "play"
          },
          "inputs": {
            "entryPointId": "5f732521-9a45-40c1-951d-f962c4908cf4",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Finalization inputs",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "prepareFinalRecords",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Prepare final records",
            "icon": "code"
          },
          "inputs": {
            "script": "const input = $vars.finalizeStart?.output ?? {}; const decision = input.managerDecision ?? {}; const disposition = decision.Action === 'Approve' ? 'Approve' : 'Reject'; const snapshot = input.latestAnalysis?.financialSnapshot ?? {}; const findings = input.latestAnalysis?.authoritativeFindings ?? []; const unresolved = findings.filter((finding) => ['pendingEvidence', 'technicalError', 'ambiguous'].includes(finding.status) || finding.evidenceState === 'missingEvidence'); return { invoiceRecordId: input.invoiceRecordId, correlationId: input.correlationId, disposition, mainRecord: { ProcessingStatus: disposition === 'Approve' ? 'Approved' : 'Rejected', SubmittedTotal: Number(snapshot.submittedTotal ?? 0), AdjustmentTotal: Number(snapshot.totalAdjustment ?? 0), PayableTotal: Number(snapshot.proposedPayable ?? 0), OpenFindingCount: unresolved.length, AwaitingEvidence: unresolved.some((finding) => finding.evidenceState === 'missingEvidence'), AnalysisVersion: Number(snapshot.version ?? input.latestAnalysis?.analysisVersion ?? 1), FindingsJson: JSON.stringify(findings) }, activityRecord: { InvoiceRecordId: input.invoiceRecordId, CorrelationId: input.correlationId, EventTimestamp: new Date().toISOString(), EventName: input.eventName, EventType: input.eventType, EventSource: input.eventSource, Summary: input.summary ?? disposition, PayloadJson: JSON.stringify({ disposition, decision, snapshot }) } };"
          },
          "outputs": {
            "output": {
              "type": "any",
              "description": "Prepared final records",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Final record preparation error",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "persistFinalRecords",
          "type": "uipath.core.rpa-workflow.dd273b1c-d925-45d0-b1b6-b719cd972819",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Persist final records",
            "subLabel": "",
            "icon": "rpa"
          },
          "inputs": {
            "in_InvoiceRecordId": "=js:$vars.prepareFinalRecords.output.invoiceRecordId",
            "in_LineRecordsJson": "=js:JSON.stringify([])",
            "in_ActivityRecordJson": "=js:JSON.stringify($vars.prepareFinalRecords.output.activityRecord ?? {})",
            "in_MainRecordUpdatesJson": "=js:JSON.stringify($vars.prepareFinalRecords.output.mainRecord ?? {})",
            "errorHandlingEnabled": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "source": "=this",
              "var": "output",
              "schema": {
                "type": "object",
                "properties": {
                  "out_Success": {
                    "type": "boolean"
                  },
                  "out_ErrorCode": {
                    "type": "string"
                  },
                  "out_ErrorMessage": {
                    "type": "string"
                  }
                }
              }
            },
            "error": {
              "type": "object",
              "description": "Error information if the node fails",
              "source": "=Error",
              "var": "error",
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "detail",
                  "category",
                  "status"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Error code as a string"
                  },
                  "message": {
                    "type": "string",
                    "description": "High-level error message"
                  },
                  "detail": {
                    "type": "string",
                    "description": "Detailed error description"
                  },
                  "category": {
                    "type": "string",
                    "description": "Error category"
                  },
                  "status": {
                    "type": "integer",
                    "description": "HTTP status code"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "id": "confirmFinalPersistence",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Confirm final persistence",
            "icon": "code"
          },
          "inputs": {
            "script": "const prepared = $vars.prepareFinalRecords.output; const persistence = $vars.persistFinalRecords.output; if (!persistence || persistence.out_Success !== true) { throw new Error(`Invoice persistence failed: ${persistence?.out_ErrorCode ?? 'Unknown'} - ${persistence?.out_ErrorMessage ?? 'No detail'}`); } return { ...prepared, persistence };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Confirmed final persistence result",

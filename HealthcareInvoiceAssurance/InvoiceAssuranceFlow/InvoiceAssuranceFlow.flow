              "out_Success": {
                "type": "boolean",
                "description": "True only when all requested writes succeed"
              },
              "out_ErrorCode": {
                "type": "string",
                "description": "Short category such as ValidationError or PersistenceError"
              },
              "out_ErrorMessage": {
                "type": "string",
                "description": "Readable failure detail"
              }
            }
          }

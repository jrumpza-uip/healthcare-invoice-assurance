            "in_LineRecordsJson": "=js:JSON.stringify($vars.assessReadiness.output.lineRecords ?? [])",
            "in_ActivityRecordJson": "=js:JSON.stringify($vars.assessReadiness.output.activityRecord ?? {})",
            "in_MainRecordUpdatesJson": "=js:JSON.stringify($vars.assessReadiness.output.mainRecord ?? {})",
            "errorHandlingEnabled": true
          },

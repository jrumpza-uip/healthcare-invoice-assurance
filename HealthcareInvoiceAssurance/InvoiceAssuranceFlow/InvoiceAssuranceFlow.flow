  "subflows": {
    "markProcessing": {
      "nodes": [
        {
          "id": "markProcessingStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "e96a60e4-4b99-463c-b6a9-dd7a4b1d8077",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "RecordActivityEvent inputs",
              "source": "=result.response",
              "var": "output"
            }
          }
        },
        {
          "id": "prepareProcessingRecords",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Prepare processing records"
          },
          "inputs": {
            "script": "const input = $vars.markProcessingStart.output; return { invoiceRecordId: input.invoiceRecordId, correlationId: input.correlationId, mainRecord: { ProcessingStatus: 'Processing', CorrelationId: input.correlationId }, activityRecord: { InvoiceRecordId: input.invoiceRecordId, CorrelationId: input.correlationId, EventTimestamp: new Date().toISOString(), EventName: input.eventName, EventType: input.eventType, EventSource: input.eventSource, Summary: input.summary, PayloadJson: input.payloadJson ?? '' } };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Prepared processing records",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Record preparation error",
              "source": "=result.Error",
              "var": "error"
            }
          }
        },
        {
          "id": "persistProcessingRecords",
          "type": "uipath.core.rpa-workflow.dd273b1c-d925-45d0-b1b6-b719cd972819",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Persist processing records"
          },
          "inputs": {
            "in_Operation": "MarkProcessing",
            "in_InvoiceRecordId": "=js:$vars.prepareProcessingRecords.output.invoiceRecordId",
            "in_CorrelationId": "=js:$vars.prepareProcessingRecords.output.correlationId",

              "var": "error",
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "detail",
                  "category",
                  "status"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Error code as a string"
                  },
                  "message": {
                    "type": "string",
                    "description": "High-level error message"
                  },
                  "detail": {
                    "type": "string",
                    "description": "Detailed error description"
                  },
                  "category": {
                    "type": "string",
                    "description": "Error category"
                  },
                  "status": {
                    "type": "integer",
                    "description": "HTTP status code"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "id": "confirmReevaluationPersistence",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Confirm re-evaluation persistence"
          },
          "inputs": {
            "script": "const prepared = $vars.assessReadiness.output; const persistence = $vars.persistReevaluationRecords.output; if (!persistence || persistence.out_Success !== true) { throw new Error(`Invoice persistence failed: ${persistence?.out_ErrorCode ?? 'Unknown'} - ${persistence?.out_ErrorMessage ?? 'No detail'}`); } return { ...prepared, persistence };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Confirmed re-evaluation persistence result",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Re-evaluation persistence confirmation error",
              "source": "=result.Error",
              "var": "error"
            }
          }
        },
        {
          "id": "reevaluateEnd",
          "type": "core.control.end",
          "typeVersion": "1.0",
          "display": {
            "label": "End"
          },
          "inputs": {},
          "outputs": {
            "output": {
              "source": "=js:$vars.confirmReevaluationPersistence.output"
            }
          }
        }
      ],

          {
            "id": "reanalyzeChangedFindings.output",
            "type": "object",
            "schema": {
              "type": "object",
              "properties": {
                "governingDocumentStack": {
                  "type": "array",
                  "description": "Effective indexed documents with topic scope and applicability reasons",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceDocumentId": {
                        "type": "string"
                      },
                      "documentTitle": {
                        "type": "string"
                      },
                      "effectiveDate": {
                        "type": "string",
                        "nullable": true
                      },
                      "topicScope": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sourceDocumentId",
                      "documentTitle",
                      "topicScope",
                      "reason"
                    ]
                  }
                },
                "normalizedRules": {
                  "type": "array",
                  "description": "Grounded supported rules for deterministic evaluation",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ruleId": {
                        "type": "string"
                      },
                      "ruleType": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "object"
                      },
                      "operands": {
                        "type": "object"
                      },
                      "effectivePeriod": {
                        "type": "object"
                      },
                      "sourceDocumentId": {
                        "type": "string"
                      },
                      "sourceClause": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "ruleId",
                      "ruleType",
                      "scope",
                      "operands",
                      "effectivePeriod",
                      "sourceDocumentId",
                      "sourceClause",
                      "confidence"
                    ]
                  }
                },
                "proposedFindings": {
                  "type": "array",
                  "description": "Exception-only charge-to-rule associations. Include only exceeded limits or caps, excluded categories, missing required evidence, or non-zero reconciliation exceptions. Never include supported, compliant, satisfied, tied, or unchanged items; use an empty array when no exception exists.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "findingId": {
                        "type": "string"
                      },
                      "chargeId": {
                        "type": "string"
                      },
                      "ruleId": {
                        "type": "string"
                      },
                      "evidenceState": {
                        "type": "string",
                        "enum": [
                          "exceededLimit",
                          "exceededCap",
                          "excludedCategory",
                          "missingEvidence",
                          "reconciliationException"
                        ],
                        "description": "Exception state only. Never infer missingEvidence from an empty evidenceTypes array unless a retrieved category-specific EvidenceRequirement expressly requires an input evidence type and its threshold applies."
                      },
                      "explanation": {
                        "type": "string"
                      },
                      "citations": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "sourceDocumentId": {
                              "type": "string"
                            },
                            "sourceClause": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "sourceDocumentId",
                            "sourceClause"
                          ]
                        }
                      }
                    },
                    "required": [
                      "findingId",
                      "chargeId",
                      "ruleId",
                      "evidenceState",
                      "explanation",
                      "citations"
                    ]
                  }
                },
                "ambiguities": {
                  "type": "array",
                  "description": "Only conflicting applicability, absent contract support, or unsupported rule concepts that block a relevant decision. Do not use for compliant values, resolved evidence, tied reconciliation, or generic charges.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ambiguityId": {
                        "type": "string"
                      },
                      "topic": {
                        "type": "string"
                      },
                      "explanation": {
                        "type": "string"
                      },
                      "affectedChargeIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "citations": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "sourceDocumentId": {
                              "type": "string"
                            },
                            "sourceClause": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "sourceDocumentId",
                            "sourceClause"
                          ]
                        }
                      }
                    },
                    "required": [
